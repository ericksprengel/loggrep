{
  "name": "loggrep",
  "description": "Compose TypeScript and JavaScript modules to filter Android logcat streams and recordings.",
  "version": "3.0.0",
  "author": "Erick Massa Sprengel",
  "bin": {
    "loggrep": "./src/cli.ts"
  },
  "bugs": "https://github.com/ericksprengel/loggrep/issues",
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.3"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/ericksprengel/loggrep",
  "keywords": [
    "logcat",
    "android",
    "bun",
    "typescript",
    "filters"
  ],
  "license": "MIT",
  "repository": "ericksprengel/loggrep",
  "scripts": {
    "dev": "bun src/cli.ts",
    "typecheck": "bun check",
    "test": "bun test"
